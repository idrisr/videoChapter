#compdef videoChapter

# Simple completion for media files by extension.
_videoChapter() {
  setopt local_options extendedglob glob

  local -a video_exts matches
  video_exts=(
    avi
    avif
    flv
    m2ts
    m4v
    mkv
    mov
    mp4
    mpg
    mpeg
    mts
    ogv
    ts
    webm
    wmv
  )

  matches=( *.(#i)(${(j:|:)video_exts})(.) )
  if (( ${#matches} )); then
    compadd -Q -a matches
  fi
  return 0
}

_videoChapter "$@"
