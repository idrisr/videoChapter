#compdef videoChapter

# Simple completion for media files by extension.
_videoChapter() {
  setopt local_options extendedglob

  local -a video_exts
  video_exts=(
    avi
    avif
    flv
    m2ts
    m4v
    mkv
    mov
    mp4
    mpg
    mpeg
    mts
    ogv
    ts
    webm
    wmv
  )

  _files -g "*.(#i)(${(j:|:)video_exts})(.)"
}

_videoChapter "$@"
